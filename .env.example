# eGuard backend the extension talks to (the ~/eguard Next.js app). Origin only, no trailing slash.
VITE_API_URL=http://localhost:3217
# Parent web app, opened by "View Parent Dashboard". Usually the same origin as the API.
VITE_WEB_APP_URL=http://localhost:3217
# development | staging | production. Production builds refuse http:// URLs.
VITE_ENVIRONMENT=development
# Public key that verifies signed family policies (base64 SPKI). Generate the pair in ~/eguard with
# `node scripts/browser-policy-keys.mjs`; the private half goes in the server's BROWSER_POLICY_SIGNING_KEY.
VITE_POLICY_PUBLIC_KEY=
